# ============================================================
#  Trimify — Local Environment Variables
#  Copy this file and fill in YOUR actual values.
#  NEVER commit this file to git (already in .gitignore).
# ============================================================

# --- MongoDB ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- JWT (pick any long random string) ---
JWT_SECRET=change_me_to_a_long_random_secret_32chars

# --- App host (no trailing slash) ---
NEXT_PUBLIC_HOST_URL=http://localhost:3000
HOST_URL=http://localhost:3000

# --- Google OAuth (from console.cloud.google.com) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email (Gmail App Password recommended) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- Paddle Payments (optional for local dev) ---
PADDLE_SERVER_API_KEY=your-paddle-api-key
WEBHOOK_SECRET_KEY=your-paddle-webhook-secret
